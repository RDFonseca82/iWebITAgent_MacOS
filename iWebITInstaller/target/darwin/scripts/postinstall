#!/bin/bash

#Custermize this for your application
APPLICATION_FILE_PATH=bin/wso2server.sh

#Parameters
PRODUCT_HOME=/Library/Application Support/iWebITAgent

echo "Post installation process started"

#Change permissions in home directory
echo "Change permissions in product home"
cd ${PRODUCT_HOME}
chmod -R 755 .
[ -d /usr/local/bin ] || mkdir /usr/local/bin

#Add application shortcut to /usr/local/bin
rm -f /usr/local/bin/iWebITAgent-2.4.7.0
ln -s ${PRODUCT_HOME}/${APPLICATION_FILE_PATH} /usr/local/bin/iWebITAgent-2.4.7.0
echo "Post installation process finished"

osascript -e 'display alert "HELLO world"'

sudo launchctl unload /Library/LaunchDaemons/com.rdfonseca.iWebITService.plist
