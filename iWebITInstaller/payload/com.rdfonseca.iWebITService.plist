<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.rdfonseca.iWebITService</string>
    <key>ProgramArguments</key>
    <array>
      <string>__PRODUCT_DIR__/iWebITService</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__PRODUCT_DIR__/Logs/service_log_success.log</string>
    <key>StandardOutPath</key>
    <string>__PRODUCT_DIR__/Logs/service_log_error.log</string>
  </dict>
</plist>